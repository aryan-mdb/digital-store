# payanfoods.com — React storefront + Laravel API on one domain.

Options -MultiViews -Indexes
RewriteEngine On

# Hostinger already redirects http → https; just fold www into the bare domain.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Pass the Bearer token through to PHP.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# API, uploaded media and the health check → Laravel.
RewriteRule ^(api|media)(/.*)?$ laravel.php [L]
RewriteRule ^up$ laravel.php [L]

# Real files (JS/CSS/images) are served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is a React route.
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|png|jpg|jpeg|svg|webp|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
